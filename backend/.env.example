# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecorevive

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# AI Provider Configuration (EcoRevive V2)
# AI_PROVIDER: 'mock' (default, 100% offline, zero-billing) or 'gemini' (optional, Google AI Studio Free Tier)
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_TIMEOUT_MS=10000
AI_OVERALL_DEADLINE_MS=25000
