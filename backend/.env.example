# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Public Application & Frontend URL (used for canonical QR code links and public profiles)
APP_URL=http://localhost:5173

# Reverse Proxy Configuration (Express trust proxy)
# Options: 'false' (disabled, default), '1' (single reverse proxy hop e.g. Render/Railway/Heroku),
# or specific subnets/IPs e.g. 'loopback', '10.0.0.0/8'
TRUST_PROXY=false

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecorevive

# PostgreSQL SSL Configuration
# Options: DB_SSL='false' (disabled, default for local), DB_SSL='true' (enabled),
# or auto-detected when DATABASE_URL has sslmode=require.
# DB_SSL_REJECT_UNAUTHORIZED='true' (enforce certificate verification, default)
# DB_SSL_REJECT_UNAUTHORIZED='false' (optional override for self-signed certificates)
# DB_SSL_CA=/path/to/ca.pem (optional custom CA certificate file or string)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (supports single origin or comma-separated list)
CORS_ORIGIN=http://localhost:5173

# External Environmental Providers Configuration
# SoilGrids multi-raster query timeout in ms (default: 25000ms / 25s bounded default)
SOILGRIDS_TIMEOUT_MS=25000
SOILGRIDS_ENABLE_REGIONAL_BASELINE=true
SOILGRIDS_REGIONAL_DISTANCE_KM=10
SOIL_TTL_MS=7776000000

# Open-Meteo Provider Configuration (default: 5000ms timeout, 30m fresh TTL, 24h max stale)
PROVIDER_TIMEOUT_MS=5000
WEATHER_FRESH_TTL_MS=1800000
WEATHER_MAX_STALE_MS=86400000

# AI Provider Configuration (EcoRevive V2)
# AI_PROVIDER: 'mock' (default, 100% offline, zero-billing) or 'gemini' (optional, Google AI Studio Free Tier)
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_TIMEOUT_MS=10000
AI_OVERALL_DEADLINE_MS=25000

# Health Intelligence Configuration
HEALTH_MONITORING_INTERVAL_DAYS=30

# Persistent Storage Configuration
# STORAGE_PROVIDER: 'local' (default for local dev and offline testing) or 'supabase' (production persistent storage)
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ecorevive-evidence
STORAGE_SIGNED_URL_EXPIRES_IN=3600
